# Copy to .env and fill in. Never commit .env.

# stdio mode: act as the user who owns this token. Unset = auto-created local user "Me".
EVENTER_TOKEN=

# Default: SQLite at %USERPROFILE%\.eventer-mcp\eventer.db. Postgres example (M6):
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/eventer
DATABASE_URL=

# HTTP mode only (M6): protects POST /admin/users.
EVENTER_ADMIN_KEY=
